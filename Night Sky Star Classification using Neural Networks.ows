		<properties node_id="25" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 1, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x19\x00\x00\x06\x8f\x00\x00\x04\x19\x00\x00\x01\x1e\x00\x00\x00\x97\x00\x00\x049\x00\x00\x02v\x00\x00\x00\x00\x02\x00\x00\x00\x06\x90\x00\x00\x00\x00\x00\x00\x005\x00\x00\x06\x8f\x00\x00\x04\x19', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}, {'name': 'Undersample', 'script': 'import Orange\nimport numpy as np\nfrom Orange.data import Domain, Table\nfrom imblearn.under_sampling import ClusterCentroids\nfrom collections import Counter\n\n# Copy input data\ndf = in_data.copy()\nX, y = df.X, df.Y\n\n# Count class frequencies\ncounts = Counter(int(val) for val in y)\nmin_count = min(counts.values())\n\n# Create strategy to downsample all classes to minority count\nstrategy = {cls: min_count for cls in counts}\n\n# Apply ClusterCentroids\ncc = ClusterCentroids(sampling_strategy=strategy)\nX_res, y_res = cc.fit_resample(X, y)\n\n# Build domain and Orange table\ndomain = Domain(df.domain.attributes, df.domain.class_vars)\nout_data = Table(domain, X_res, y_res)\n', 'filename': None}], 'scriptText': 'import Orange\nimport numpy as np\nfrom Orange.data import Domain, Table\nfrom imblearn.under_sampling import ClusterCentroids\nfrom collections import Counter\n\n# Copy input data\ndf = in_data.copy()\nX, y = df.X, df.Y\n\n# Count class frequencies\ncounts = Counter(int(val) for val in y)\nmin_count = min(counts.values())\n\n# Create strategy to downsample all classes to minority count\nstrategy = {cls: min_count for cls in counts}\n\n# Apply ClusterCentroids\ncc = ClusterCentroids(sampling_strategy=strategy)\nX_res, y_res = cc.fit_resample(X, y)\n\n# Build domain and Orange table\ndomain = Domain(df.domain.attributes, df.domain.class_vars)\nout_data = Table(domain, X_res, y_res)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x02\x1c\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
