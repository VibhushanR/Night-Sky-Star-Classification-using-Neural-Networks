		<properties node_id="27" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 2, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01\x1e\x00\x00\x00{\x00\x00\x049\x00\x00\x02v\x00\x00\x01\x1e\x00\x00\x00\x97\x00\x00\x049\x00\x00\x02v\x00\x00\x00\x00\x00\x00\x00\x00\x06\x90\x00\x00\x01\x1e\x00\x00\x00\x97\x00\x00\x049\x00\x00\x02v', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}, {'name': 'Undersample', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}, {'name': 'SMOTE', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import Orange\nimport numpy as np\nfrom Orange.data import Domain, Table\nfrom imblearn.over_sampling import SMOTE\nfrom collections import Counter\n\n# Ensure data is connected\ndf = in_data.copy()\nX, y = df.X, df.Y\n\n# Show class distribution before resampling\nprint("Before SMOTE:", Counter(int(val) for val in y))\n\n# Apply SMOTE to balance all classes\nsmote = SMOTE()\nX_res, y_res = smote.fit_resample(X, y)\n\n# Show class distribution after resampling\nprint("After SMOTE:", Counter(int(val) for val in y_res))\n\n# Create new Orange table\ndomain = Domain(df.domain.attributes, df.domain.class_vars)\nout_data = Table(domain, X_res, y_res)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xab\x00\x00\x00k\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
